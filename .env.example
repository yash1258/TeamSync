# Local development environment variables for TeamSync.
# Copy to .env.local and fill in real values.

# Convex client URL used by Next.js frontend.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex deployment selector (example: dev:my-team-my-app).
CONVEX_DEPLOYMENT=dev:your-team-your-app

# Convex auth provider domain used in convex/auth.config.ts.
# For local web app usage, http://localhost:3000 is typical.
CONVEX_SITE_URL=http://localhost:3000

# Optional frontend site URL helper.
NEXT_PUBLIC_CONVEX_SITE_URL=http://localhost:3000

# Planning hub feature flags.
NEXT_PUBLIC_FEATURE_PLANNING_HUB=true
FEATURE_PLANNING_HUB=true
